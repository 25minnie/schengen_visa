<!DOCTYPE html>
<html lang="zh-CN">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>申根材料 3 步测 · 春小签</title>
<style>
  :root{
    --eu:#00be8f; --eu-d:#009e76; --gold:#ffc200; --gold-d:#e0a800;
    --paper:#f4f5f6; --card:#ffffff; --ink:#1d2530; --ink2:#5b6670; --line:#e7eaec;
    --alert:#ed4444; --shadow:0 1px 3px rgba(0,0,0,.06),0 10px 24px rgba(0,0,0,.06);
  }
  *{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    font-family:-apple-system,BlinkMacSystemFont,"Segoe UI","PingFang SC","Microsoft YaHei",sans-serif;
    background:var(--paper); color:var(--ink); line-height:1.6;
    -webkit-font-smoothing:antialiased; text-rendering:optimizeLegibility;
    padding:0 0 40px;
  }
  .wrap{max-width:680px; margin:0 auto; padding:0 18px}

  /* ===== 顶部品牌条 ===== */
  .topbar{display:flex; align-items:center; justify-content:space-between; gap:10px;
    padding:14px 18px; max-width:680px; margin:0 auto}
  .brand{display:flex; align-items:center; gap:8px; font-weight:800; font-size:16px; letter-spacing:.5px}
  .brand .logo{width:34px; height:34px; border-radius:50%; background:#fff; object-fit:contain; box-shadow:0 1px 4px rgba(0,0,0,.14)}
  .topbar .tag{font-size:12px; color:var(--eu-d); background:#E6F7F2; border:1px solid var(--eu);
    border-radius:999px; padding:4px 11px; font-weight:700}

  /* ===== Hero ===== */
  .hero{position:relative; overflow:hidden; margin:6px 14px 18px; border-radius:22px;
    background:radial-gradient(120% 140% at 12% -10%, rgba(0,190,143,.14), transparent 55%),
               linear-gradient(180deg,#ffffff,#f1faf6);
    padding:26px 24px 22px; box-shadow:var(--shadow)}
  .hero::after{content:""; position:absolute; right:-60px; top:-50px; width:220px; height:220px;
    border-radius:50%; background:radial-gradient(circle,rgba(255,194,0,.16),transparent 70%); pointer-events:none}
  .hero .emo{font-size:30px; line-height:1; vertical-align:middle; margin-right:6px}
  .hero h1{margin:12px 0 8px; font-size:25px; letter-spacing:.5px}
  .hero h1 .hl{color:var(--eu-d)}
  .hero p{margin:0; color:var(--ink2); font-size:14.5px}
  .hero .pillrow{display:flex; gap:8px; flex-wrap:wrap; margin-top:14px}
  .pill{font-size:12.5px; font-weight:700; color:var(--ink2); background:#fff; border:1px solid var(--line);
    border-radius:999px; padding:5px 12px; box-shadow:0 1px 2px rgba(0,0,0,.04)}

  /* ===== 进度条 ===== */
  .progress{display:flex; align-items:center; gap:10px; margin:0 14px 14px; max-width:680px}
  .pbar{flex:1; height:8px; border-radius:999px; background:#e3e7e9; overflow:hidden}
  .pbar > i{display:block; height:100%; width:33%; background:linear-gradient(90deg,var(--eu),var(--eu-d));
    border-radius:999px; transition:width .35s ease}
  .pstep{font-size:13px; font-weight:700; color:var(--eu-d); white-space:nowrap}

  /* ===== 问题卡片 ===== */
  .qcard{background:var(--card); border:1px solid var(--line); border-radius:20px; padding:22px 20px 24px;
    margin:0 14px 14px; max-width:680px; box-shadow:var(--shadow); animation:fade .35s ease both}
  .qcard .qno{font-size:13px; font-weight:800; color:var(--gold-d); letter-spacing:1px}
  .qcard h2{margin:6px 0 4px; font-size:20px}
  .qcard .qhint{margin:0 0 16px; color:var(--ink2); font-size:14px}
  .opts{display:grid; gap:12px}
  .opt{display:flex; align-items:center; gap:14px; padding:16px 18px; border:2px solid var(--line);
    border-radius:16px; cursor:pointer; background:#fff; transition:all .15s ease; font-size:16px; font-weight:600}
  .opt .ic{font-size:28px; line-height:1; flex-shrink:0}
  .opt .tx{display:flex; flex-direction:column}
  .opt .tx small{font-weight:500; color:var(--ink2); font-size:12.5px; margin-top:2px}
  .opt:active{transform:scale(.985)}
  @media(hover:hover){.opt:hover{border-color:var(--eu); box-shadow:0 6px 16px rgba(0,190,143,.16)}}
  .opt.sel{border-color:var(--eu); background:#E6F7F2}

  .navbtns{display:flex; gap:10px; margin-top:18px}
  .btn{flex:1; border:none; border-radius:14px; padding:14px; font-size:15.5px; font-weight:700; cursor:pointer;
    font-family:inherit; transition:all .15s ease}
  .btn.ghost{background:#fff; color:var(--ink2); border:1px solid var(--line)}
  .btn.primary{background:linear-gradient(135deg,var(--eu),var(--eu-d)); color:#fff; box-shadow:0 8px 18px rgba(0,190,143,.32)}
  .btn:disabled{opacity:.4; cursor:not-allowed}
  .btn.primary:active{transform:translateY(1px)}

  /* ===== 结果 ===== */
  .result{margin:0 14px; max-width:680px; animation:fade .45s ease both}
  .rhead{background:linear-gradient(135deg,var(--eu),var(--eu-d)); color:#fff; border-radius:20px;
    padding:22px 22px 20px; box-shadow:var(--shadow); position:relative; overflow:hidden}
  .rhead::after{content:""; position:absolute; right:-40px; bottom:-50px; width:160px; height:160px;
    border-radius:50%; background:radial-gradient(circle,rgba(255,255,255,.18),transparent 70%)}
  .rhead .celeb{font-size:34px}
  .rhead h2{margin:8px 0 4px; font-size:21px}
  .rhead .rtags{display:flex; gap:8px; flex-wrap:wrap; margin-top:10px}
  .rtag{font-size:12.5px; font-weight:700; background:rgba(255,255,255,.22); border:1px solid rgba(255,255,255,.35);
    border-radius:999px; padding:4px 11px}
  .rprog{margin-top:14px; background:rgba(255,255,255,.2); border-radius:999px; height:10px; overflow:hidden}
  .rprog > i{display:block; height:100%; width:0; background:#fff; border-radius:999px; transition:width .4s ease}
  .rprog-txt{margin-top:8px; font-size:13px; font-weight:700; opacity:.95}

  .group{background:var(--card); border:1px solid var(--line); border-radius:18px; padding:16px 16px 8px;
    margin-top:14px; box-shadow:var(--shadow)}
  .group h3{margin:0 0 12px; font-size:15.5px; display:flex; align-items:center; gap:8px}
  .group h3 .gn{width:24px; height:24px; border-radius:8px; background:var(--eu); color:#fff; font-size:13px;
    display:flex; align-items:center; justify-content:center; font-weight:800}
  .group h3 .gn.gold{background:var(--gold-d)}
  .mitem{display:flex; gap:12px; align-items:flex-start; padding:11px 4px; border-bottom:1px solid #f0f2f3}
  .mitem:last-child{border-bottom:none}
  .mitem .cb{flex-shrink:0; width:22px; height:22px; margin-top:2px; border-radius:7px; border:2px solid var(--line);
    display:flex; align-items:center; justify-content:center; cursor:pointer; transition:all .15s ease; font-size:14px; color:#fff}
  .mitem.done .cb{background:var(--eu); border-color:var(--eu)}
  .mitem.done .mt{text-decoration:line-through; color:#9aa4ac}
  .mitem .mt{font-weight:700; font-size:15.5px}
  .mitem .md{font-size:13px; color:var(--ink2); margin-top:2px}
  .badge-must{display:inline-block; font-size:11px; font-weight:800; color:var(--alert); background:#fdeaea;
    border:1px solid #f3c4c4; border-radius:6px; padding:1px 7px; margin-left:8px; vertical-align:middle}
  .badge-opt{display:inline-block; font-size:11px; font-weight:800; color:var(--ink2); background:#f1f3f4;
    border:1px solid var(--line); border-radius:6px; padding:1px 7px; margin-left:8px; vertical-align:middle}

  .foot{margin:18px 14px 0; max-width:680px; text-align:center; color:var(--ink2); font-size:12.5px; line-height:1.7}
  .foot .brand2{font-weight:800; color:var(--eu-d)}
  .replay{display:inline-flex; align-items:center; gap:8px; margin-top:6px; background:#fff; border:1px solid var(--eu);
    color:var(--eu-d); font-weight:700; border-radius:999px; padding:10px 20px; cursor:pointer; font-size:14.5px;
    font-family:inherit}
  .replay:active{transform:translateY(1px)}

  @keyframes fade{from{opacity:0; transform:translateY(8px)} to{opacity:1; transform:none}}
  @media(max-width:560px){
    .hero{padding:26px 18px 22px; border-radius:18px}
    .hero h1{font-size:22px}
    .qcard{padding:18px 16px 20px; border-radius:18px}
    .qcard h2{font-size:18px}
    .opt{padding:14px 15px}
    .opt .ic{font-size:25px}
  }
</style>
</head>
<body>

  <div class="topbar">
    <div class="brand"><img class="logo" src="data:image/jpeg;base64," alt="春小签">春小签</div>
  </div>

  <div class="hero">
    <h1><span class="emo">📋</span>申根材料，<span class="hl">3 步</span>就测明白</h1>
  </div>

  <!-- 进度 -->
  <div class="progress">
    <div class="pbar"><i id="pbar"></i></div>
    <span class="pstep" id="pstep">第 1 / 3 步</span>
  </div>

  <!-- 问题容器 -->
  <div id="quiz"></div>

  <!-- 结果容器 -->
  <div id="result" style="display:none"></div>

<script>
/* ===== 真实材料数据（与内部一本通同源） ===== */
const COMMON=[
 ["护照","有效期 6 个月以上，至少 2 页空白签证页",1],
 ["照片","近 6 个月白底彩色证件照 2 张",1],
 ["申请表","完整填写并签名",1],
 ["身份证","正反面复印件",1],
 ["户口本","全本复印件",0],
 ["保险","申根区有效医疗保险，保额不低于 3 万欧元",1],
 ["资金证明","近 6 个月银行流水 + 存款证明",1]
];
const SPEC={
 tour:[["行程单","往返机票 / 酒店 / 详细行程安排",1]],
 visit:[["邀请函","由邀请人出具并签字",1],["接待证明","当地市政厅官方接待证明",1],["邀请人证件","护照 / 居留复印件",1]],
 biz:[["邀请函","邀请公司出具，含行程与目的",1],["营业执照","中方公司营业执照复印件",1],["公司担保函","准假与费用担保证明",1]]
};
const MINOR=[
 ["出生医学证明","复印件",1],
 ["出生证公证认证","未满 18 周岁须提供",1],
 ["父母委托公证认证","父母一方不同行时须提供",1],
 ["亲属关系公证认证","未成年人申请须提供",1],
 ["在校 / 学生证","在校学生另提供",0]
];
const FREE_EXTRA=[
 ["结婚证公证认证","已婚无业者须提供（半年内开具）",0],
 ["出生证公证认证","未婚无业者须提供",0],
 ["资产担保函","配偶或父母的资产担保（无收入来源时）",0],
 ["配偶资产证明","已婚无业者提供配偶流水 / 存款",0],
 ["父母资产证明","学生 / 未婚无业者提供父母流水 / 存款",0]
];
/* 按身份补充 */
const ROLE={
 emp:[["在职证明","含准假、薪资、职位、公司联系方式，加盖公章",1],["公司资质","中方公司营业执照复印件（盖章）",0]],
 ret:[["退休证","复印件",1],["退休金流水","近 6 个月退休金银行流水",1]],
 stu:[["在校证明","学校出具，含准假信息",1]],
 free:FREE_EXTRA
};
const ROLE_LABEL={emp:"在职",ret:"退休",stu:"学生",free:"自由职业 / 无业"};
const PURPOSE_LABEL={tour:"旅游",visit:"探亲访友",biz:"商务"};

/* ===== 题目 ===== */
const QUESTIONS=[
 {key:"purpose", no:"QUESTION 01", q:"你这趟去申根，主要为了？", hint:"不同类型要补的材料不一样哦",
  opts:[{v:"tour",ic:"🏖️",t:"旅游度假",s:"看风景、买买买、放松一下"},
        {v:"visit",ic:"👨‍👩‍👧",t:"探亲访友",s:"去看在当地的亲友"},
        {v:"biz",ic:"💼",t:"商务出差",s:"开会、考察、文化交流"}]},
 {key:"role", no:"QUESTION 02", q:"你的身份是？", hint:"在职 / 学生要的材料最省心",
  opts:[{v:"emp",ic:"💼",t:"在职",s:"有稳定工作和收入"},
        {v:"stu",ic:"🎓",t:"学生",s:"在校读书中"},
        {v:"ret",ic:"🧓",t:"退休",s:"已退休领退休金"},
        {v:"free",ic:"🌟",t:"自由职业 / 无业",s:"无固定雇主"}]},
 {key:"minor", no:"QUESTION 03", q:"会带 18 岁以下小朋友一起吗？", hint:"未成年小朋友要多几份公证",
  opts:[{v:"yes",ic:"👶",t:"会带小朋友",s:"有一名或多名未成年同行"},
        {v:"no",ic:"🙋",t:"不带",s:"只有大人出行"}]}
];

let step=0;
const ans={};

const quizEl=document.getElementById("quiz");
const resEl=document.getElementById("result");
const pbar=document.getElementById("pbar");
const pstep=document.getElementById("pstep");

function renderStep(){
  const Q=QUESTIONS[step];
  pbar.style.width=((step+1)/QUESTIONS.length*100)+"%";
  pstep.textContent="第 "+(step+1)+" / "+QUESTIONS.length+" 步";
  let html='<div class="qcard"><div class="qno">'+Q.no+'</div><h2>'+Q.q+'</h2>'+
           '<p class="qhint">'+Q.hint+'</p><div class="opts">';
  Q.opts.forEach(o=>{
    const sel=ans[Q.key]===o.v?' sel':'';
    html+='<div class="opt'+sel+'" onclick="choose(\''+Q.key+'\',\''+o.v+'\')">'+
          '<span class="ic">'+o.ic+'</span><span class="tx"><span>'+o.t+'</span><small>'+o.s+'</small></span></div>';
  });
  html+='</div><div class="navbtns">';
  if(step>0) html+='<button class="btn ghost" onclick="go(-1)">← 上一步</button>';
  html+='<button class="btn primary" onclick="go(1)" '+(ans[Q.key]?'':'disabled')+'>下一步 →</button>';
  html+='</div></div>';
  quizEl.innerHTML=html;
  quizEl.style.display="block";
  resEl.style.display="none";
  window.scrollTo({top:0,behavior:'smooth'});
}

function choose(key,v){
  ans[key]=v;
  renderStep();
}
function go(d){
  if(d>0 && !ans[QUESTIONS[step].key]) return;
  step+=d;
  if(step>=QUESTIONS.length){ buildResult(); return; }
  renderStep();
}

/* ===== 生成结果 ===== */
function buildResult(){
  quizEl.style.display="none";
  pbar.style.width="100%";
  pstep.textContent="搞定 🎉";

  const purpose=ans.purpose, role=ans.role, minor=ans.minor;
  let items=[];
  const seen=new Set();
  function add(list){
    list.forEach(([t,d,m])=>{ if(!seen.has(t)){ seen.add(t); items.push([t,d,m]); } });
  }
  add(COMMON);
  add(SPEC[purpose]);
  add(ROLE[role]);
  if(minor==="yes") add(MINOR);

  const groups=[
    {title:"所有人都要带", cls:"", list:COMMON, note:""},
    {title:"因为是「"+PURPOSE_LABEL[purpose]+"」要补", cls:"", list:SPEC[purpose], note:""},
    {title:"因为你是「"+ROLE_LABEL[role]+"」要补", cls:"", list:ROLE[role], note:""}
  ];
  if(minor==="yes") groups.push({title:"因为带小朋友要补", cls:"gold", list:MINOR, note:""});

  let gh="";
  groups.forEach((g,gi)=>{
    const n=g.cls==="gold"?' gold':'';
    let lis="";
    g.list.forEach(([t,d,m])=>{
      lis+='<div class="mitem" onclick="toggle(this)"><div class="cb">✓</div>'+
           '<div><div class="mt">'+t+(m?'<span class="badge-must">必备</span>':'<span class="badge-opt">按需</span>')+'</div>'+
           '<div class="md">'+d+'</div></div></div>';
    });
    gh+='<div class="group"><h3><span class="gn'+n+'">'+(gi+1)+'</span>'+g.title+'</h3>'+lis+'</div>';
  });

  resEl.innerHTML=
    '<div class="result">'+
    '<div class="rhead"><div class="celeb">🎉</div><h2>你的专属申根材料包</h2>'+
    '<div class="rtags"><span class="rtag">'+PURPOSE_LABEL[purpose]+'</span>'+
    '<span class="rtag">'+ROLE_LABEL[role]+'</span>'+
    '<span class="rtag">'+(minor==="yes"?"带未成年":"仅大人")+'</span></div>'+
    '<div class="rprog"><i id="rprogbar"></i></div>'+
    '<div class="rprog-txt" id="rprogtxt">已准备 0 / '+items.length+'</div></div>'+
    gh+
    '<div class="foot"><span class="brand2">春小签</span> 提醒：以上为通用参考清单，最终以送签领馆实际要求为准。'+
    '材料有疑问？交给春小签帮你逐项把关 ✅<br>'+
    '<button class="replay" onclick="restart()">🔄 重新测一次</button></div>'+
    '</div>';

  resEl.style.display="block";
  window.scrollTo({top:0,behavior:'smooth'});
  updateProg();
}

function toggle(el){
  el.classList.toggle("done");
  updateProg();
}
function updateProg(){
  const all=resEl.querySelectorAll(".mitem");
  const done=resEl.querySelectorAll(".mitem.done");
  const pct=all.length? Math.round(done.length/all.length*100):0;
  const bar=document.getElementById("rprogbar");
  const txt=document.getElementById("rprogtxt");
  if(bar) bar.style.width=pct+"%";
  if(txt) txt.textContent="已准备 "+done.length+" / "+all.length+(pct===100?" · 全部就绪，出发！🚀":"");
}
function restart(){
  step=0; ans={}; renderStep();
}

renderStep();
</script>
</body>
</html>
